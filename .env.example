# Copy this file to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Google PageSpeed Insights API key, server-only. Enable the API in your
# own Google Cloud project and restrict the key to PageSpeed Insights API.
# Do not use NEXT_PUBLIC_, commit this value, or paste it into a chat.
PAGESPEED_API_KEY=
