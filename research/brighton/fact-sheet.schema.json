{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brighton-public-fact-sheet/v1",
  "title": "Brighton public fact sheet",
  "description": "Publicly retrieved facts for one Brighton business. Every positive claim points at a source URL and the date that URL was accessed. Empty arrays mean the pass did not retrieve that kind of fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "businessName",
    "researchedOn",
    "researchTarget",
    "category",
    "address",
    "phones",
    "profiles",
    "hours",
    "offerings",
    "publicDescriptions",
    "attributes",
    "publicRecords",
    "photos",
    "unknown",
    "conflicts",
    "fetchAttempts",
    "generatorMustNot"
  ],
  "properties": {
    "schemaVersion": { "const": "brighton-public-fact-sheet/v1" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "businessName": { "type": "string", "minLength": 1 },
    "researchedOn": { "$ref": "#/$defs/date" },
    "researchTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "addressAsSupplied", "note"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "addressAsSupplied": { "type": "string", "minLength": 1 },
        "note": { "const": "Supplied for the sprint. This is not a public-source confirmation." }
      }
    },
    "category": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "address": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "phones": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
    "hours": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "offerings": { "type": "array", "items": { "$ref": "#/$defs/offering" } },
    "publicDescriptions": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "attributes": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "publicRecords": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
    "unknown": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "fetchAttempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
    "generatorMustNot": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "accessed", "excerpt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "accessed": { "$ref": "#/$defs/date" },
        "excerpt": { "type": "string", "minLength": 8, "maxLength": 400 }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "sources"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "detail", "publishedPrice", "sources"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "detail": { "type": ["string", "null"] },
        "publishedPrice": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "label", "relationship", "note", "accessed"],
      "properties": {
        "kind": {
          "enum": ["website", "social", "booking", "directory", "map", "ordering"]
        },
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "minLength": 1 },
        "relationship": {
          "enum": [
            "first-party",
            "linked-by-another-public-page",
            "directory-listing",
            "login-wall",
            "not-found",
            "script-only",
            "did-not-resolve"
          ]
        },
        "note": { "type": "string", "minLength": 1 },
        "accessed": { "$ref": "#/$defs/date" }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageUrl", "imageUrl", "note", "accessed"],
      "properties": {
        "pageUrl": { "type": "string", "format": "uri" },
        "imageUrl": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "note": { "type": "string", "minLength": 1 },
        "accessed": { "$ref": "#/$defs/date" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "note", "sources"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "accessed", "httpStatus", "note"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "accessed": { "$ref": "#/$defs/date" },
        "httpStatus": { "type": ["integer", "null"] },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
